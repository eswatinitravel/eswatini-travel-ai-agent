# Copy this file to .env.local and fill in your PayPal SANDBOX app credentials.
# developer.paypal.com > Apps & Credentials > Sandbox > Default Application
# NEVER commit .env.local to GitHub.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI agent (optional). Any OpenAI-compatible chat completions API with tool calling.
# Default is Groq's free tier: get a key at https://console.groq.com/keys (no credit card).
# Leave LLM_API_KEY empty and the agent uses its built-in rule-based parser instead.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
